---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import StatTiles from '../components/StatTiles.astro';
import WeeklyBars from '../components/WeeklyBars.astro';
import { recentWeeks, totals, lines, compact, pct } from '../lib/stats';
import { getCollection } from 'astro:content';
import { SITE } from '../consts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),

);
const weeks = recentWeeks(16);
const t = totals(weeks);
---

<Base>
  <section>
    <h1>Hi!</h1>
    <p>
      I'm at least two decades overdue to have a blog but I'm on a plane over the Pacific and can't sleep
      so it's time to finish setting this up!
    </p>
    <p>
      Hi, I'm Andy!<br>
      My day job is enabling agents to use Google Cloud databases.  In my spare time I'm exploring AI
      and learning to build new things with new tools.  The ones that might be useful or interesting 
      I share.  <br>

      Please note that one of my goals is to test the capabilities of new models and coding
      agents - so virtually all of the code is written by AI and only lightly reviewed by me.
    </p>
    <p>
      <b>You're welcome to use anything here - but if you're working on something that matters, please 
      review the code before you deploy it. </b>
    </p>
    <p class="meta">
      <a href={SITE.github}>GitHub</a> · <a href={SITE.linkedin}>LinkedIn</a> · <a href="/rss.xml">RSS</a>
    </p>
  </section>

  <h2>How much of this is AI?</h2>
  <p class="meta">
    Last 16 weeks across all my projects. <a href="/stats/">Full breakdown and methodology →</a>
  </p>
  <StatTiles
    tiles={[
      { label: 'of lines AI-written', value: pct(t.aiShare) },
      { label: 'hours with Claude', value: compact(t.hours) },
      { label: 'chores by hand', value: t.chores.toLocaleString('en-US') },
    ]}
  />
  <WeeklyBars
    title="Who wrote the code"
    subtitle="Lines added and deleted, per week"
    source="git history of my repos"
    weeks={weeks}
    height={140}
    format={compact}
    series={[
      { name: 'AI-written', color: '--series-1', value: (w) => lines(w, 'ai') },
      { name: 'By hand', color: '--series-2', value: (w) => lines(w, 'hand') },
    ]}
  />

  <h2>Writing</h2>
  <PostList posts={posts} />
</Base>
