---
import Base from '../../layouts/Base.astro';
import StatTiles from '../../components/StatTiles.astro';
import DailyBars from '../../components/DailyBars.astro';
import data from '../../data/yard-sightings.json';

// Generated by Yardwatch (`yardwatch public`), a private project. Only per-day visit counts per species are
// published: no times, no camera names or locations, no captions, no clips, no people. Never hand-edit.
const totalVisits = data.species.reduce((n, s) => n + s.visits, 0);
const fmtDay = (d: string) =>
  new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' });
const fmtLong = (d: string) =>
  new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const PLURALS: Record<string, string> = {
  fox: 'foxes', deer: 'deer', 'rat or mouse': 'rats or mice', 'lizard or snake': 'lizards or snakes',
};
const plural = (name: string, n: number) => (n === 1 ? name : PLURALS[name] ?? `${name}s`);

// Colour follows the animal, never its rank. Owner, 2026-10-27: use a wider range of colours, even at some cost to
// colour-blind readers; the tooltip, legend and day-by-day list carry the same numbers in text.
const COLORS: [string, string, string][] = [
  ['raccoon', 'Raccoons', 'var(--series-1)'],
  ['cat', 'Cats', 'var(--series-2)'],
  ['opossum', 'Opossums', 'var(--series-3)'],
  ['squirrel', 'Squirrels', 'var(--series-4)'],
  ['bird', 'Birds', 'var(--series-5)'],
  ['dog', 'Dogs', 'var(--series-6)'],
  ['skunk', 'Skunks', '#e67e22'],
  ['rat or mouse', 'Rats or mice', '#8d6e63'],
  ['rabbit', 'Rabbits', '#f48fb1'],
  ['hawk', 'Hawks', '#c2185b'],
  ['owl', 'Owls', '#7e57c2'],
  ['deer', 'Deer', '#c8a165'],
  ['coyote', 'Coyotes', '#ff7043'],
  ['fox', 'Foxes', '#ef6c00'],
  ['bobcat', 'Bobcats', '#6d4c41'],
  ['mountain lion', 'Mountain lions', '#bf360c'],
  ['lizard or snake', 'Lizards or snakes', '#9ccc65'],
  ['unidentified animal', 'Unidentified', 'var(--series-other)'],
];
const byDate = new Map(data.days.map((d) => [d.date, d.visits as Record<string, number>]));
const days: string[] = [];
if (data.first && data.last) {
  for (let t = Date.parse(data.first + 'T12:00:00Z'); t <= Date.parse(data.last + 'T12:00:00Z'); t += 86400000) {
    days.push(new Date(t).toISOString().slice(0, 10));
  }
}
const seen = new Set(data.species.map((s) => s.name));
const known = COLORS.filter(([key]) => seen.has(key));
const unknown = [...seen].filter((k) => !COLORS.some(([key]) => key === k)); // a new species before it gets a colour
const series = [
  ...known.map(([, name, color]) => ({ name, color })),
  ...(unknown.length ? [{ name: 'Other', color: 'var(--series-other)' }] : []),
];
const values = days.map((d) => {
  const v = byDate.get(d) ?? {};
  const row = known.map(([key]) => v[key] ?? 0);
  return unknown.length ? [...row, unknown.reduce((a, k) => a + (v[k] ?? 0), 0)] : row;
});
---

<Base title="Yard wildlife" description="A daily log of the animals our yard cameras see at night: raccoons, cats, opossums and the occasional surprise.">
  <h1>Yard wildlife</h1>
  {data.first && <p class="meta">{fmtLong(data.first)} to {fmtLong(data.last)} · updated {fmtLong(data.generated)}.</p>}

  <DailyBars
    title="Animal visits per day"
    subtitle="One visit = one kind of animal seen on any camera, gaps under 20 minutes"
    days={days}
    series={series}
    values={values}
  />

  <StatTiles
    tiles={[
      { label: 'animal visits', value: totalVisits.toLocaleString('en-US') },
      { label: 'kinds of animal', value: String(data.species.filter((s) => s.name !== 'unidentified animal').length) },
      { label: 'days with visits', value: String(data.days.length) },
    ]}
  />

  <h2>Who visits</h2>
  <div class="table-scroll">
    <table>
      <thead><tr><th>Animal</th><th>Visits</th><th>Days seen</th></tr></thead>
      <tbody>
        {data.species.map((s) => (
          <tr><td>{s.name}</td><td>{s.visits}</td><td>{s.days}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <details class="table-view">
    <summary>Day by day</summary>
    <ul class="yard-days">
      {data.days.map((d) => (
        <li>
          <span class="yard-date">{fmtDay(d.date)}</span>
          <span>
            {Object.entries(d.visits).map(([name, n], i) => (
              <>{i > 0 && ' · '}{n} {plural(name, n as number)}</>
            ))}
          </span>
        </li>
      ))}
    </ul>
  </details>

  <h2>About this page</h2>
  <p>
    Our yard cameras see a surprising amount of wildlife, mostly at night: raccoons and neighborhood cats above
    all, with opossums, squirrels and the occasional surprise. This log is built by <strong>Yardwatch</strong>, a
    small personal project that reads our own cameras' event history and the descriptions Google's Gemini writes
    for each clip.
  </p>
  <p>
    A <em>visit</em> is one kind of animal seen on any camera with gaps of less than {data.visit_gap_min} minutes,
    so a raccoon family crossing five cameras counts once. The animal comes from the camera's own description of
    each clip, so expect the odd mistake; "unidentified animal" means the camera flagged an animal without naming
    it.
  </p>
  <p>
    On purpose, this page leaves out times of day, which camera saw what, and anything about people. See
    the <a href="/yard/privacy/">Yardwatch privacy policy</a> and <a href="/yard/terms/">terms</a>.
  </p>
</Base>

<style>
  .yard-days { list-style: none; padding: 0; margin: 1rem 0 0; }
  .yard-days li { display: flex; gap: 1rem; padding: 0.4rem 0; border-bottom: 1px solid var(--border); margin: 0; }
  .yard-date { flex: 0 0 7.5rem; color: var(--ink-2); font-variant-numeric: tabular-nums; }
</style>
