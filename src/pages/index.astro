---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../consts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base>
  <section>
    <h1>Andrew Brook</h1>
    <p>
      My day job is enabling agents to use Google Cloud databases.  In my spare time I'm exploring AI
      and learning to build new things with new tools.  The ones that might be useful or interesting 
      I share.  

      Please note that one of my goals is to test the capabilities of new models and coding
      agents - so virtually all of the code is written by AI and only lightly reviewed by me.

      <b>You're welcome to use it - but if you're working on something that matters, review the code
      yourself. </b>
    </p>
    <p class="meta">
      <a href={SITE.github}>GitHub</a> · <a href={SITE.linkedin}>LinkedIn</a> · <a href="/rss.xml">RSS</a>
    </p>
  </section>

  <h2>Writing</h2>
  <PostList posts={posts} />
</Base>
