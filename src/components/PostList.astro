---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

{
  posts.length === 0 ? (
    <p class="meta">Nothing published yet.</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <h2><a href={`/writing/${post.id}/`}>{post.data.title}</a></h2>
          <span class="meta"><time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time></span>
          <p>{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <ul class="tags">
              {post.data.tags.map((tag) => <li class="tag">{tag}</li>)}
            </ul>
          )}
        </li>
      ))}
    </ul>
  )
}
