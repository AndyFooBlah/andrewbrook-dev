---
import Base from '../layouts/Base.astro';
import StatTiles from '../components/StatTiles.astro';
import WeeklyBars from '../components/WeeklyBars.astro';
import CategoryBars from '../components/CategoryBars.astro';
import {
  stats, recentWeeks, totals, lines, chores, claudeHours, compact, pct,
  CHORE_LABELS, weekRange, modelSeries, rankedModels, modelLabel, tokens, tokenTotal,
} from '../lib/stats';

const weeks = recentWeeks(52);
const t = totals(weeks);
const fmtHours = (n: number) => `${Math.round(n * 10) / 10}`;
const SRC_GIT = 'git history of my repos';
const SRC_CLAUDE = 'Claude Code transcripts; web sessions estimated';
const SRC_LEDGER = 'my own ledger';
const updated = new Date(stats.generated + 'T00:00:00Z').toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC',
});
---

<Base title="Stats" description="How much of my code is written by AI, how many hours I spend with Claude, and what I still have to do by hand.">
  <h1>Stats</h1>
  <p>
    Nearly everything I build is written by a coding agent. This page tracks what that actually looks
    like: lines the agent wrote versus lines I wrote or edited by hand, the hours I spent driving it,
    which models did the work, and the chores that still needed a human. Numbers are weekly totals across all my projects;
    nothing here says which project.
  </p>
  <p class="meta">Updated {updated}.</p>

  <StatTiles
    tiles={[
      { label: 'of lines changed were AI-written', value: pct(t.aiShare), note: `${compact(t.ai)} AI · ${compact(t.hand)} by hand` },
      { label: 'hours working with Claude', value: compact(t.hours), note: `${t.sessions.toLocaleString('en-US')} sessions` },
      { label: 'tokens Claude wrote', value: compact(t.outputTokens), note: `${compact(t.cacheReadTokens)} read from cache` },
      { label: 'chores done by hand', value: t.chores.toLocaleString('en-US'), note: `${compact(t.choreMinutes / 60)} hours` },
    ]}
  />

  <WeeklyBars
    title="Who wrote the code"
    subtitle="Lines added and deleted, per week"
    source={SRC_GIT}
    weeks={weeks}
    format={compact}
    series={[
      { name: 'AI-written', color: '--series-1', value: (w) => lines(w, 'ai') },
      { name: 'By hand', color: '--series-2', value: (w) => lines(w, 'hand') },
    ]}
  />

  <WeeklyBars
    title="Who made the commits"
    subtitle="Commits, per week"
    source={SRC_GIT}
    weeks={weeks}
    height={120}
    series={[
      { name: 'AI-written', color: '--series-1', value: (w) => w.ai_commits },
      { name: 'By hand', color: '--series-2', value: (w) => w.hand_commits },
    ]}
  />

  <WeeklyBars
    title="Time at the keyboard with Claude"
    subtitle="Active hours, per week"
    source={SRC_CLAUDE}
    weeks={weeks}
    height={120}
    format={fmtHours}
    series={[{ name: 'Hours', color: '--series-1', value: claudeHours }]}
  />

  <div class="viz-pair">
    <WeeklyBars
      title="Which models did the work"
      subtitle="Output tokens, per week"
      source={SRC_CLAUDE}
      weeks={weeks}
      height={120}
      format={compact}
      series={modelSeries(weeks, 'output')}
    />
    <CategoryBars
      title="Output tokens by model"
      subtitle="Tokens, total"
      source={SRC_CLAUDE}
      format={compact}
      rows={rankedModels(weeks).map((m) => ({ label: modelLabel(m), value: weeks.reduce((a, w) => a + tokens(w, m, 'output'), 0) }))}
    />
  </div>

  <div class="viz-pair">
    <WeeklyBars
      title="Chores I had to do myself"
      subtitle="Tasks handed back to me, per week"
      source={SRC_LEDGER}
      weeks={weeks}
      height={120}
      series={[{ name: 'Chores', color: '--series-1', value: chores }]}
    />
    <CategoryBars
      title="What kind of chores"
      subtitle="Tasks, total"
      source={SRC_LEDGER}
      rows={stats.chore_categories.map((c) => ({ label: CHORE_LABELS[c] ?? c, value: t.byChore[c] }))}
    />
  </div>

  <details class="table-view">
    <summary>Weekly table</summary>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Week</th><th>AI lines</th><th>Hand lines</th><th>AI commits</th><th>Hand commits</th>
            <th>Claude hours</th><th>Sessions</th><th>Tokens out</th><th>Chores</th>
          </tr>
        </thead>
        <tbody>
          {weeks.slice().reverse().map((w) => (
            <tr>
              <td>{weekRange(w)}</td>
              <td>{lines(w, 'ai').toLocaleString('en-US')}</td>
              <td>{lines(w, 'hand').toLocaleString('en-US')}</td>
              <td>{w.ai_commits}</td>
              <td>{w.hand_commits}</td>
              <td>{fmtHours(claudeHours(w))}h</td>
              <td>{w.sessions + w.web_sessions}</td>
              <td>{compact(tokenTotal(w, 'output'))}</td>
              <td>{chores(w)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>

  <h2>How this is measured</h2>
  <ul>
    <li>
      <b>AI vs hand.</b> Every commit a coding agent makes carries a <code>Co-Authored-By</code> trailer
      or an <i>Assisted by Claude</i> line. Lines added and deleted in those commits count as AI-written;
      all other commits count as by hand. That cuts both ways: a hand edit folded into an agent's commit
      is invisible, and an agent commit that lost its attribution counts as by hand. Before September 2026
      I made no hand commits at all, so everything before then counts as AI-written. Lockfiles, vendored
      data, generated images and build output are excluded.
    </li>
    <li>
      <b>Hours.</b> Local Claude Code sessions leave timestamped transcripts; time between messages
      counts as active up to a {stats.idle_gap_minutes}-minute gap, and parallel sessions are not
      double counted. Sessions run from the web or phone leave no transcript, so each is estimated at{' '}
      {stats.web_session_minutes} minutes.
    </li>
    <li>
      <b>Tokens.</b> Every local transcript message records the model and its token counts. "Tokens
      Claude wrote" is output tokens, the model's own text, code and reasoning; the far larger cache-read
      figure is context re-read from the prompt cache on each request. Web and phone sessions are missing
      here too.
    </li>
    <li>
      <b>Blind spots.</b> Only Claude Code is measured for hours, tokens and chores. I also use Gemini
      CLI, Antigravity and Gemini now and then, and did so more a few months ago; that work shows up in
      the AI-written lines but nowhere else on this page.
    </li>
    <li>
      <b>Chores.</b> Things the agent could not do and handed back to me: run this in your terminal,
      click through a console, paste a secret, try it on your phone. A small model reads the last message
      of every local session turn and flags them, with an estimated duration; sessions from the web or
      phone leave no transcript, so those are missed.
    </li>
  </ul>
  <p class="meta">
    The collector is <a href="https://github.com/AndyFooBlah/andrewbrook-dev/tree/main/scripts/coding-stats">open source</a>;
    the list of repos it reads and the chore notes stay on my machine.
  </p>
</Base>
